@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(alpaka CONFIG)
find_dependency(Threads)
if(NOT TARGET alpakaMetrics::alpakaDependency)
    add_library(alpakaMetrics::alpakaDependency INTERFACE IMPORTED)
    set_target_properties(alpakaMetrics::alpakaDependency PROPERTIES INTERFACE_LINK_LIBRARIES alpaka::alpaka)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/alpakaMetricsTargets.cmake")
