@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(alpaka CONFIG)
find_dependency(Threads)
if(@alpakaMetrics_DEP_PAPI@)
    set(_alpakaMetrics_saved_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    set(alpakaMetrics_PAPI_LIBRARY_HINT "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
    find_dependency(PAPI)
    set(CMAKE_MODULE_PATH "${_alpakaMetrics_saved_module_path}")
    unset(_alpakaMetrics_saved_module_path)
    unset(alpakaMetrics_PAPI_LIBRARY_HINT)
endif()
if(NOT TARGET alpakaMetrics::alpakaDependency)
    add_library(alpakaMetrics::alpakaDependency INTERFACE IMPORTED)
    set_target_properties(alpakaMetrics::alpakaDependency PROPERTIES INTERFACE_LINK_LIBRARIES alpaka::alpaka)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/alpakaMetricsTargets.cmake")
